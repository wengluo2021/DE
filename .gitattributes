*.json text eol=lf
*.jsonl text eol=lf
*.py text eol=lf
*.html text eol=lf
*.md text eol=lf
scripts/** text eol=lf
# Frozen A source snapshots, exports and gold keep the exact committed bytes.
data/** -text
artifacts/a_review/** -text

# Upstream review/provenance snapshots retain their original byte-level SHA.
docs/provenance/** -text

# Keep diagnostic logs byte-exact, including native Windows CRLF endings.
artifacts/c/m6-review-http-readonly*/server.log -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Saved evaluation exports and backup packages keep their checksummed bytes.
exports/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
