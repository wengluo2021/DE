# Whitelist source, explicit configuration, tests and frozen inputs.
**
!Dockerfile
!.dockerignore
!requirements.txt
!requirements-dev.txt
!requirements-linux.txt
!requirements-*.txt
!app/
!app/**
!config/
!config/**
!scripts/
!scripts/**
!tests/
!tests/**
!docs/
!docs/**
!README.md
!开发文档.md
!B开发文档.md
!B测试.md
!项目设计.md
!data/
!data/.gitkeep
!data/manifest.json
!data/corpus_manifest.json
!data/sources.json
!data/formal_corpus/
!data/formal_corpus/manifest.json
!data/formal_corpus/raw/
!data/formal_corpus/raw/**
!data/formal_corpus/processed/
!data/formal_corpus/processed/**
!data/raw/
!data/raw/**
!data/processed/
!data/processed/**
!data/eval/
!data/eval/**

# Exclude these even inside otherwise allowed source directories.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.git/
**/.private/
**/.env
**/.env.*
**/*.env
**/*.env.*
**/*.sqlite3
**/*.sqlite3-*
**/*.lock
# Directory exceptions above permit traversal; explicitly deny runtime trees
# afterward so repository builds never read a live database or native index.
data/chroma/
data/chunks/
data/indexes/
data/sqlite/
data/runs/
data/b-fixtures/
data/b-clean-verification/
data/formal_corpus/chroma/
data/formal_corpus/chunks/
data/formal_corpus/indexes/
data/formal_corpus/sqlite/
data/formal_corpus/runs/
!.env.example
