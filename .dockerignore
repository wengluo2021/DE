# Whitelist source, explicit configuration, tests and frozen inputs.
**
!Dockerfile
!.dockerignore
!requirements.txt
!requirements-dev.txt
!requirements-linux.txt
!requirements-*.txt
!app/
!app/**
!config/
!config/**
!scripts/
!scripts/**
!tests/
!tests/**
!docs/
!docs/**
!README.md
!开发文档.md
!B开发文档.md
!B测试.md
!项目设计.md
!data/
!data/.gitkeep
!data/manifest.json
!data/raw/
!data/raw/**
!data/processed/
!data/processed/**
!data/eval/
!data/eval/**

# Exclude these even inside otherwise allowed source directories.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.git/
**/.private/
**/.env
**/.env.*
**/*.env
**/*.env.*
**/*.sqlite3
**/*.sqlite3-*
!.env.example
